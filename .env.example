# Copy to .env (never commit .env). Load via your secret manager in production.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://xtc:CHANGE_ME@localhost:5432/xtc

# Identity service signing secret (HS256), >= 32 random chars. Rotate via secret manager.
JWT_SECRET=
JWT_ISSUER=xtc-identity
JWT_AUDIENCE=xtc-wallet

# true = enable admin-only simulated payment events. Startup REFUSES this when NODE_ENV=production.
WEBHOOK_SIMULATION=false

# Provider credentials (leave unset => endpoint answers 503 provider_not_configured)
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_AUTH=
APPLE_ROOT_CA_PEM=            # PEM of Apple Root CA - G3 (pinned trust anchor)
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

CORS_ALLOWED_ORIGINS=         # comma-separated; empty = no cross-origin access
RATE_LIMIT_PER_MINUTE=120

# --- Phase 5 ---
# Runtime login must be a member of xtc_app (NOT superuser/BYPASSRLS; production startup asserts this).
# Admin login (member of xtc_admin): policy approval, holds, wallet freezes. Optional; those routes answer 503 without it.
ADMIN_DATABASE_URL=
# Owner credentials used ONLY by `npm run migrate`. Production does not migrate on startup.
MIGRATION_DATABASE_URL=
# Required in production for shared rate limits across instances (or ALLOW_LOCAL_RATE_LIMIT=true for a single instance).
REDIS_URL=
ALLOW_LOCAL_RATE_LIMIT=false
# simulation | stripe. Production refuses simulation. The Stripe client has NOT been verified against Stripe.
PAYOUT_PROVIDER=simulation
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com
